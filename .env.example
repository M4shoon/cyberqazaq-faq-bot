# Осы файлды .env деп көшіріп толтырыңыз. .env GitHub-қа ЖІБЕРІЛМЕЙДІ (.gitignore).
# Кілтсіз де бот жұмыс істейді (құжаттан үзінді көрсетеді).

# Google AI Studio-дан алған кілт (aistudio.google.com → Get API key)
GEMINI_API_KEY=

# Модель атауы AI Studio-дағы тізімнен алынады (атаулар өзгеріп тұрады). Әдепкі: gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash
